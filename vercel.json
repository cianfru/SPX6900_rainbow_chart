{
  "git": { "deploymentEnabled": false },
  "functions": {
    "api/og.js": {
      "includeFiles": "{scripts/bot/**,public/{history,onchain,whales,chain-wallets,cex-flow,freefloat-peers,rotation-excludes,cohort-survival,exit-flow,smart-money,city-history,valuation,aeon-*}.json}"
    },
    "api/recap.js": {
      "includeFiles": "{scripts/bot/**,public/{history,onchain,whales,chain-wallets,cex-flow,freefloat-peers,rotation-excludes,cohort-survival,exit-flow,smart-money}.json}"
    },
    "api/agent.js": {
      "includeFiles": "{scripts/bot/**,public/{history,onchain,whales,chain-wallets,cex-flow,freefloat-peers,rotation-excludes,cohort-survival,exit-flow,smart-money,city-history}.json}"
    },
    "api/live-flow.js": {
      "includeFiles": "public/{whales,base-onchain,solana-onchain}.json"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "chart", "value": "(?<cid>[^&]+)" },
        { "type": "header", "key": "user-agent", "value": ".*([Bb]ot|facebookexternalhit|WhatsApp|Slack|Telegram|Discord|Twitter|LinkedIn|Pinterest|Embedly|Slurp|redditbot|Applebot|preview|crawler|spider).*" }
      ],
      "destination": "/share?chart=:cid",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/control",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/city",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:html|json))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/memekings",
      "destination": "/api/majors?set=meme"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/share",
      "destination": "/api/share"
    },
    {
      "source": "/control",
      "destination": "/control.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}