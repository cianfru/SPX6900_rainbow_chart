{
  "functions": {
    "api/og.js": { "includeFiles": "{scripts/bot/**,public/history.json}" },
    "api/recap.js": { "includeFiles": "{scripts/bot/**,public/history.json}" },
    "api/agent.js": { "includeFiles": "{scripts/bot/**,public/history.json}" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/share", "destination": "/api/share" },
    { "source": "/control", "destination": "/control.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
